# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens
# (it needs Ingesting permission)

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 OTLP/gRPC ingress endpoint
# Copy it from https://app.dash0.com → Settings → Endpoints → "OTLP via gRPC":
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_OTLP_GRPC_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Dataset the telemetry lands in
DASH0_DATASET=default

# Value of the deployment.environment.name resource attribute
DASH0_ENVIRONMENT=local

# Browser monitoring: by default the page sends telemetry to the local
# OpenTelemetry Collector (http://<this host>:4318), so no Dash0 token ends up
# in the browser. Only set these two if you want the browser to talk to Dash0
# directly — in that case use a SEPARATE token limited to Ingesting, because it
# becomes public in the page.
# DASH0_WEB_ENDPOINT=https://ingress.us-west-2.aws.dash0.com
# DASH0_WEB_AUTH_TOKEN=public_ingest_token_here

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
